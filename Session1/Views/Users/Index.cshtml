<!DOCTYPE html>
<html>
<head>
    <title>Page Title</title>
</head>
<body>

    <h1>All Users</h1>
    @foreach(var user in @Model)
    {
        <h2>@user</h2>
    }

    <ul>
        @foreach (var item in @Model)
        {
            <li>@item</li>
        }
    </ul>

    <table border="1">
        <thead>
            <th>Nmae</th>
        </thead>
        <tbody>
            @foreach (var item in @Model)
            {
                <tr>
                    <td>@item</td>
                </tr>
            }
        </tbody>
    </table>

    <select>
        @foreach (var item in @Model)
        {
            <option>@item</option>
        }
    </select>
</body>
</html>


